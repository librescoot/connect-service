# The HTTPS ingress must overwrite X-Real-IP. Replace this documentation IP
# with that ingress's exact private source address, never an entire subnet.
set_real_ip_from 192.0.2.1;
real_ip_header X-Real-IP;
limit_req_zone $binary_remote_addr zone=pairing_requests:10m rate=5r/s;
limit_conn_zone $binary_remote_addr zone=pairing_connections:10m;

server {
    listen 8080;
    server_name connect.librescoot.org;
    access_log off;
    error_log /dev/null crit;
    client_max_body_size 8k;
    client_body_timeout 10s;
    limit_req zone=pairing_requests burst=20 nodelay;
    limit_req_status 429;
    limit_conn pairing_connections 20;
    limit_conn_status 429;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
        proxy_send_timeout 15s;
    }
}
